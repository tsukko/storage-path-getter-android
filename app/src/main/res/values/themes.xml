<resources>
    <!-- Base application theme. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- スプラッシュ画面の背景色 -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <!-- スプラッシュ画面中央のアイコン（指定しない場合はアプリアイコンが使用されます） -->
        <!-- <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item> -->

        <!-- スプラッシュが終わった後に適用される本来のテーマ -->
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>

    <!-- 本来のテーマ（UIにActionBarを表示しない設定） -->
    <style name="Theme.MyApplication" parent="android:Theme.Material.NoActionBar">
        <!-- Compose側で制御するため、XMLでの色指定は最小限でOK -->
    </style>
</resources>
